# ==============================================================================
# pie-Switch Environment Configuration
# ==============================================================================

# Operating Mode: 'business' (Enterprise Checkout) or 'indie' (Sleep-Mode DevOps Sidekick)
MODE=business

# Team & Room Identification
TEAM_NAME=pie
SWITCH_ROOM_ID=pie-war-room
CREATOR_HANDLE=@alex

# Switch Agent Protocol Gateway Endpoints
SWITCH_SERVER_URL=http://localhost:8000
SWITCH_SSE_URL=http://localhost:8000/rooms/pie-war-room/events
SWITCH_POST_URL=http://localhost:8000/rooms/pie-war-room/messages

# Target Microservice Endpoint & Paths
TARGET_SERVICE_HOST=127.0.0.1
TARGET_SERVICE_PORT=8080
TARGET_SERVICE_URL=http://127.0.0.1:8080

# Workspace Volumes
LOG_FILE_PATH=./workspace/service.log
PATCH_FILE_PATH=./workspace/patches/fix.patch
REPRO_FILE_PATH=./workspace/repro/repro_bug.py

# Logging verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
